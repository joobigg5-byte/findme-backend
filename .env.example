# Copy this file to .env and fill in real values before deploying.
# Locally, the app runs fine without a .env at all — these are the
# defaults used for development, shown here so you know what to change.

# Postgres connection string. Leave unset locally to use SQLite instead.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Generate a real one with: python3 -c "import secrets; print(secrets.token_hex(32))"
# JWT_SECRET_KEY=replace-this-with-a-real-random-value
